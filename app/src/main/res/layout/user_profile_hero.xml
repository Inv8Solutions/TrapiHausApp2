<?xml version="1.0" encoding="utf-8"?>
<!--
    User Profile Hero Section
    Displays: Avatar, Name, Email, and Stats (Bookings, Reviews, Rating)
    Reuses: bg_white_circle for avatar background
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/user_login_background"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <!-- Profile Header: Avatar, Name, Email -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp"
        android:baselineAligned="false">

        <!-- Avatar Circle -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_white_circle"
            android:layout_marginEnd="16dp">

            <ImageView
                android:id="@+id/profile_avatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/user_icon"
                android:scaleType="centerInside"
                android:padding="12dp"
                android:contentDescription="@string/profile_avatar" />
        </FrameLayout>

        <!-- Name and Email Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start">

            <TextView
                android:id="@+id/profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_name_placeholder"
                android:fontFamily="@font/lexend"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profile_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_email_placeholder"
                android:fontFamily="@font/lexend"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:alpha="0.8" />
        </LinearLayout>
    </LinearLayout>

    <!-- Stats Row: Bookings, Reviews, Rating -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false">

        <!-- Bookings Stat -->
        <include
            layout="@layout/user_profile_stat_item"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp" />

        <!-- Reviews Stat -->
        <include
            layout="@layout/user_profile_stat_item"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp" />

        <!-- Rating Stat -->
        <include
            layout="@layout/user_profile_stat_item"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>

