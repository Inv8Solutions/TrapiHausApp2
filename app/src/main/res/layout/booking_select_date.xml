<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- 1. HEADER -->
    <!-- Added width/height here so constraints work -->
    <include
        android:id="@+id/layoutHeader"
        layout="@layout/booking_select_date_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 2. FOOTER -->
    <!-- Added width/height here. Anchored to Bottom. -->
    <include
        android:id="@+id/layoutFooter"
        layout="@layout/booking_select_date_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 3. SCROLLABLE CONTENT -->
    <!-- Height 0dp allows it to stretch between Header and Footer -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintBottom_toTopOf="@id/layoutFooter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                layout="@layout/booking_select_date_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                layout="@layout/booking_select_date_inputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                layout="@layout/booking_select_date_guests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Bottom padding for scrolling comfort -->
            <View
                android:layout_width="match_parent"
                android:layout_height="20dp"/>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>