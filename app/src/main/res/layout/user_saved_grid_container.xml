<?xml version="1.0" encoding="utf-8"?>
<!--
    Grid container for saved properties using RecyclerView.
    Displays properties in a 2-column grid layout.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="8dp">

    <!-- Info Text -->
    <TextView
        android:id="@+id/saved_items_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="12dp"
        android:text="@string/saved_accommodations_found"
        android:textColor="#757575"
        android:textSize="12sp"
        android:fontFamily="@font/lexend"/>

    <!-- RecyclerView for Grid Layout -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/saved_properties_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingBottom="20dp"/>

</LinearLayout>

