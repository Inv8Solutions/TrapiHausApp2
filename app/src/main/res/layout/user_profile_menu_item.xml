<?xml version="1.0" encoding="utf-8"?>
<!--
    Individual menu item for profile settings
    Modular component with icon, title, subtitle, and navigation arrow
    Used for: Notifications, Privacy & Security, Payment Methods, Reviews, Help Center
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Icon -->
    <ImageView
        android:id="@+id/menu_item_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/location_icon"
        android:contentDescription="@string/menu_item_icon"
        android:scaleType="fitCenter"
        app:tint="#757575"
        android:layout_marginEnd="16dp" />

    <!-- Title and Subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="start">

        <TextView
            android:id="@+id/menu_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notifications"
            android:fontFamily="@font/lexend"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menu_item_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manage_your_notifications"
            android:fontFamily="@font/lexend"
            android:textColor="#757575"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Navigation Arrow -->
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/back_arrow"
        android:contentDescription="@string/navigate"
        android:scaleType="fitCenter"
        app:tint="#BDBDBD"
        android:layout_marginStart="16dp"
        android:rotation="180" />

</LinearLayout>

