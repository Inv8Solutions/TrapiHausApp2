<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Image -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:color/darker_gray"
                android:scaleType="centerCrop"/>
        </androidx.cardview.widget.CardView>

        <!-- Text Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/cardImage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/cardImage">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sunrise Pines Lodge"
                android:fontFamily="@font/lexend"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#212121"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Near Saint Louis University"
                android:fontFamily="@font/lexend"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginTop="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 October 24-27, 2025"
                android:fontFamily="@font/lexend"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginTop="2dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 2 guests"
                android:fontFamily="@font/lexend"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Message/Call Buttons -->
        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardImage">

            <android.widget.Button
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Message Host"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:fontFamily="@font/lexend"
                android:textColor="#212121"
                android:background="@drawable/shape_btn_outline_grey"
                android:layout_marginEnd="8dp"/>

            <android.widget.Button
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Call"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:fontFamily="@font/lexend"
                android:textColor="#212121"
                android:background="@drawable/shape_btn_outline_grey"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Divider & Pricing -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F5F5F5"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/layoutActions"/>

        <TextView
            android:id="@+id/tvTotalLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total"
            android:fontFamily="@font/lexend"
            android:textColor="#757575"
            android:textSize="14sp"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₱4,180.00"
            android:fontFamily="@font/lexend"
            android:textColor="#212121"
            android:textStyle="bold"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTotalLabel"
            app:layout_constraintBottom_toBottomOf="@id/tvTotalLabel"/>

        <!-- Cancel/View Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvTotalLabel">

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="Cancel Booking"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/lexend"
                android:textColor="#0F7BEF"
                android:background="@drawable/shape_btn_outline_blue"
                android:layout_marginEnd="8dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1.2"
                android:text="View Accomodation"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/lexend"
                android:textColor="#FFFFFF"
                android:background="@drawable/shape_button_blue"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>